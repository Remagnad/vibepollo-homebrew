[Unit]
Description=Vibeshine virtual-display control socket
PartOf=vibeshine-vkms.service

[Socket]
ListenStream=/run/vibeshine/vkms-control.sock
# Vibepollo validates this endpoint as root-owned before using it.
# Limit access to the installing desktop user's private primary group.
SocketUser=root
SocketGroup=@VIBESHINE_SOCKET_GROUP@
SocketMode=0660
DirectoryMode=0755
Accept=yes
RemoveOnStop=yes
MaxConnections=16
MaxConnectionsPerSource=4
