[Unit]
Description=Vibeshine virtual-display control connection
Requires=vibeshine-vkms.service
After=vibeshine-vkms.service

[Service]
Type=exec
User=root
ExecStart=/var/lib/vibepollo/drm/bin/vibeshine-vkms-peercred /var/lib/vibepollo/drm/bin/vibeshine-vkms control
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
RuntimeMaxSec=5s
TimeoutStopSec=1s
KillMode=control-group
SendSIGKILL=yes
MemoryMax=32M
TasksMax=16
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/sys/kernel/config/vibeshine-drm -/sys/kernel/config/vkms /run/vibeshine/vkms-leases
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
