[Unit]
Description=Vibeshine virtual display pool
Documentation=https://docs.kernel.org/gpu/vkms.html
Wants=vibeshine-vkms-control.socket
After=local-fs.target
Before=systemd-user-sessions.service display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=vibeshine/vkms-leases
RuntimeDirectoryMode=0700
ExecStartPre=/var/lib/vibepollo/drm/bin/vibeshine-drmctl status
ExecStart=/var/lib/vibepollo/drm/bin/vibeshine-vkms start
ExecStop=/var/lib/vibepollo/drm/bin/vibeshine-vkms stop
ExecStopPost=/var/lib/vibepollo/drm/bin/vibeshine-vkms-quiesce
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0022

[Install]
WantedBy=multi-user.target
