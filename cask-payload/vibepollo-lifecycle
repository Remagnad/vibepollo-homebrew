#!/usr/bin/env bash
set -Eeuo pipefail

export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
umask 077

DRM_ROOT="/var/lib/vibepollo/drm"
BIN_DIR="$DRM_ROOT/bin"
STATE_DIR="$DRM_ROOT/state"
INSTALL_STATE="$STATE_DIR/vibeshine-drm-install"
LIFECYCLE_STATE="$STATE_DIR/vibepollo-lifecycle"
POOL_UNIT="vibeshine-vkms.service"
CONTROL_SOCKET="vibeshine-vkms-control.socket"
MODULE_NAME="vibeshine_drm"
DRMCTL="$BIN_DIR/vibeshine-drmctl"
SELF="$BIN_DIR/vibepollo-lifecycle"
USER_LAUNCH="$BIN_DIR/vibepollo-user-launch"
AUTOSTART_NAME="vibepollo-homebrew.desktop"
AUTOSTART_EXEC="$USER_LAUNCH"

log() { printf 'vibepollo lifecycle: %s\n' "$*" >&2; }
fail() { log "error: $*"; exit 1; }

state_value() {
  local file="$1" key="$2"
  [[ -f "$file" && ! -L "$file" ]] || return 0
  awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$file"
}

require_root_directory() {
  local path="$1" mode
  [[ -d "$path" && ! -L "$path" ]] || fail "unsafe or missing directory: $path"
  [[ "$(stat -c '%u' "$path")" == 0 ]] || fail "$path is not root-owned"
  mode="$(stat -c '%a' "$path")"
  (( (8#$mode & 0022) == 0 )) || fail "$path is writable by group or others"
}

require_root_file() {
  local path="$1" mode
  [[ -f "$path" && ! -L "$path" ]] || fail "unsafe or missing file: $path"
  [[ "$(stat -c '%u' "$path")" == 0 ]] || fail "$path is not root-owned"
  mode="$(stat -c '%a' "$path")"
  (( (8#$mode & 0022) == 0 )) || fail "$path is writable by group or others"
}

bounded_systemctl() {
  local limit="$1" description="$2" rc=0
  shift 2
  log "$description"
  timeout --foreground --kill-after=5s "${limit}s" systemctl "$@" || rc=$?
  if (( rc == 124 || rc == 137 )); then
    fail "systemd timed out while $description"
  elif (( rc != 0 )); then
    fail "systemd failed while $description (exit $rc)"
  fi
}

unit_is_active() {
  local unit="$1" rc=0
  timeout --foreground --kill-after=5s 10s systemctl is-active --quiet "$unit" || rc=$?
  case "$rc" in
    0) return 0 ;;
    3|4) return 1 ;;
    *) fail "could not safely determine whether $unit is active (exit $rc)" ;;
  esac
}

load_and_verify_state() {
  local expected actual helper unit
  require_root_directory /var
  require_root_directory /var/lib
  require_root_directory /var/lib/vibepollo
  require_root_directory "$DRM_ROOT"
  require_root_directory "$BIN_DIR"
  require_root_directory "$STATE_DIR"
  require_root_file "$INSTALL_STATE"
  require_root_file "$LIFECYCLE_STATE"

  DESKTOP_UID="$(state_value "$LIFECYCLE_STATE" desktop_uid)"
  APP_PREFIX="$(state_value "$LIFECYCLE_STATE" app_prefix)"
  AUTOSTART_ENABLED="$(state_value "$LIFECYCLE_STATE" autostart_enabled)"
  AUTOSTART_SHA="$(state_value "$LIFECYCLE_STATE" autostart_sha256)"
  [[ "$DESKTOP_UID" =~ ^[1-9][0-9]*$ ]] || fail "invalid desktop UID in lifecycle state"
  [[ "$APP_PREFIX" == /* && "$APP_PREFIX" != *$'\n'* ]] || fail "invalid app Formula prefix in lifecycle state"
  [[ "$AUTOSTART_ENABLED" == 0 || "$AUTOSTART_ENABLED" == 1 ]] || fail "invalid autostart state"
  [[ "$AUTOSTART_SHA" =~ ^[0-9a-f]{64}$ ]] || fail "invalid autostart desktop-file checksum"

  for helper in vibeshine-drmctl vibeshine-vkms vibeshine-vkms-quiesce vibeshine-vkms-peercred vibepollo-lifecycle vibepollo-user-launch; do
    [[ -f "$BIN_DIR/$helper" && ! -L "$BIN_DIR/$helper" ]] || fail "installed helper is missing: $helper"
    expected="$(state_value "$INSTALL_STATE" "helper_${helper}_sha256")"
    [[ "$expected" =~ ^[0-9a-f]{64}$ ]] || fail "Cask ownership checksum is missing for $helper"
    actual="$(sha256sum "$BIN_DIR/$helper" | awk '{print $1}')"
    [[ "$actual" == "$expected" ]] || fail "$helper differs from the Cask-owned version"
  done

  for unit in "$POOL_UNIT" "$CONTROL_SOCKET" "vibeshine-vkms-control@.service"; do
    [[ -f "/etc/systemd/system/$unit" && ! -L "/etc/systemd/system/$unit" ]] || fail "installed systemd unit is missing or unsafe: $unit"
    expected="$(state_value "$INSTALL_STATE" "unit_${unit}_sha256")"
    [[ "$expected" =~ ^[0-9a-f]{64}$ ]] || fail "Cask ownership checksum is missing for $unit"
    actual="$(sha256sum "/etc/systemd/system/$unit" | awk '{print $1}')"
    [[ "$actual" == "$expected" ]] || fail "$unit differs from the Cask-owned version"
  done

  [[ -x "$APP_PREFIX/bin/vibepollo" ]] || fail "Vibepollo app Formula is not available at $APP_PREFIX"
  command -v systemctl >/dev/null 2>&1 || fail "systemctl is required"
  command -v timeout >/dev/null 2>&1 || fail "timeout is required"
  command -v sha256sum >/dev/null 2>&1 || fail "sha256sum is required"
  command -v getent >/dev/null 2>&1 || fail "getent is required"
  command -v runuser >/dev/null 2>&1 || fail "runuser from util-linux is required"
  command -v readlink >/dev/null 2>&1 || fail "readlink is required"
}

resolve_desktop_user() {
  local entry
  entry="$(getent passwd "$DESKTOP_UID")" || fail "could not resolve the installed desktop account (UID $DESKTOP_UID)"
  IFS=: read -r DESKTOP_USER _ RESOLVED_UID DESKTOP_GID _ DESKTOP_HOME _ <<< "$entry"
  [[ "$RESOLVED_UID" == "$DESKTOP_UID" && "$DESKTOP_USER" != root ]] || fail "desktop account identity is invalid"
  [[ "$DESKTOP_HOME" == /* && -d "$DESKTOP_HOME" ]] || fail "desktop account home directory is unavailable"
  [[ "$DESKTOP_HOME" != "/" ]] || fail "refusing to use the filesystem root as a home directory"
  AUTOSTART_DIR="$DESKTOP_HOME/.config/autostart"
  [[ ! -L "$DESKTOP_HOME/.config" ]] || fail "refusing a symbolic-link .config directory"
  [[ ! -L "$AUTOSTART_DIR" ]] || fail "refusing a symbolic-link autostart directory"
  AUTOSTART_FILE="$AUTOSTART_DIR/$AUTOSTART_NAME"
}

verify_invoking_user() {
  local invoking_uid="${PKEXEC_UID:-${SUDO_UID:-}}"
  # Homebrew's Cask uninstaller already runs as root; GUI callers arrive
  # through pkexec and carry PKEXEC_UID.
  [[ "$EUID" -eq 0 && -z "$invoking_uid" ]] && return 0
  [[ "$invoking_uid" =~ ^[1-9][0-9]*$ ]] || fail "run this command through pkexec from the installed desktop account"
  [[ "$invoking_uid" == "$DESKTOP_UID" ]] || fail "this integration belongs to desktop UID $DESKTOP_UID, not UID $invoking_uid"
}

desktop_entry() {
  cat <<EOF
[Desktop Entry]
Type=Application
Name=Vibepollo
Comment=Start the Vibepollo streaming host with the graphical session
Exec=$AUTOSTART_EXEC
Terminal=false
X-GNOME-Autostart-enabled=true
EOF
}

expected_autostart_sha() {
  desktop_entry | sha256sum | awk '{print $1}'
}

install_autostart_entry() {
  local expected tmp actual owner
  expected="$(expected_autostart_sha)"
  [[ "$expected" == "$AUTOSTART_SHA" ]] || fail "desktop autostart definition does not match its recorded checksum"

  resolve_desktop_user
  if [[ -e "$AUTOSTART_FILE" || -L "$AUTOSTART_FILE" ]]; then
    [[ -f "$AUTOSTART_FILE" && ! -L "$AUTOSTART_FILE" ]] || fail "refusing to replace an unsafe autostart entry: $AUTOSTART_FILE"
    owner="$(stat -c '%u' "$AUTOSTART_FILE")"
    actual="$(sha256sum "$AUTOSTART_FILE" | awk '{print $1}')"
    [[ "$owner" == "$DESKTOP_UID" && "$actual" == "$expected" ]] ||
      fail "an existing $AUTOSTART_NAME is not owned by this Cask; preserving it"
    log "the desktop autostart entry is already installed"
    return 0
  fi

  tmp="$(mktemp /run/vibepollo-autostart.XXXXXX)"
  trap 'rm -f -- "$tmp"' RETURN
  desktop_entry > "$tmp"
  chmod 0644 "$tmp"
  runuser -u "$DESKTOP_USER" -- install -d -m 0755 "$AUTOSTART_DIR"
  runuser -u "$DESKTOP_USER" -- install -m 0644 "$tmp" "$AUTOSTART_FILE"
  [[ "$(stat -c '%u' "$AUTOSTART_FILE")" == "$DESKTOP_UID" ]] || fail "autostart entry was not created for the desktop user"
  [[ "$(sha256sum "$AUTOSTART_FILE" | awk '{print $1}')" == "$expected" ]] || fail "autostart entry verification failed"
  rm -f -- "$tmp"
  trap - RETURN
  log "installed the per-user XDG autostart entry"
}

remove_autostart_entry() {
  local expected owner actual
  resolve_desktop_user
  if [[ ! -e "$AUTOSTART_FILE" && ! -L "$AUTOSTART_FILE" ]]; then
    log "the desktop autostart entry is already absent"
    return 0
  fi
  [[ -f "$AUTOSTART_FILE" && ! -L "$AUTOSTART_FILE" ]] || fail "refusing to remove an unsafe autostart entry"
  owner="$(stat -c '%u' "$AUTOSTART_FILE")"
  actual="$(sha256sum "$AUTOSTART_FILE" | awk '{print $1}')"
  expected="$(expected_autostart_sha)"
  [[ "$owner" == "$DESKTOP_UID" && "$actual" == "$expected" && "$actual" == "$AUTOSTART_SHA" ]] ||
    fail "the desktop autostart entry was changed outside this Cask; preserving it"
  runuser -u "$DESKTOP_USER" -- rm -- "$AUTOSTART_FILE"
  rmdir "$AUTOSTART_DIR" 2>/dev/null || true
  rmdir "$DESKTOP_HOME/.config" 2>/dev/null || true
  log "removed the Cask-owned desktop autostart entry"
}

update_lifecycle_state() {
  local key="$1" value="$2" tmp state_sha receipt_tmp
  tmp="$(mktemp "$STATE_DIR/.vibepollo-lifecycle.XXXXXX")" || return 1
  if ! awk -F= -v key="$key" -v value="$value" '
    BEGIN { OFS = "="; seen = 0 }
    $1 == key { print key, value; seen = 1; next }
    { print }
    END { if (!seen) print key, value }
  ' "$LIFECYCLE_STATE" > "$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  if ! chown root:root "$tmp" || ! chmod 0644 "$tmp" || ! mv -f -- "$tmp" "$LIFECYCLE_STATE"; then
    rm -f -- "$tmp"
    return 1
  fi

  # The lifecycle state is intentionally mutable (autostart is a user
  # preference). Refresh its root-owned Cask receipt after every atomic update
  # so uninstall can distinguish our current state from an external edit.
  state_sha="$(sha256sum "$LIFECYCLE_STATE" | awk '{print $1}')" || return 1
  receipt_tmp="$(mktemp "$STATE_DIR/.vibeshine-drm-install.XXXXXX")" || return 1
  if ! awk -F= -v sha="$state_sha" '
    BEGIN { seen = 0 }
    $1 == "lifecycle_state_sha256" {
      print "lifecycle_state_sha256=" sha
      seen = 1
      next
    }
    { print }
    END { if (!seen) print "lifecycle_state_sha256=" sha }
  ' "$INSTALL_STATE" > "$receipt_tmp"; then
    rm -f -- "$receipt_tmp"
    return 1
  fi
  if ! chown root:root "$receipt_tmp" || ! chmod 0644 "$receipt_tmp" ||
     ! mv -f -- "$receipt_tmp" "$INSTALL_STATE"; then
    rm -f -- "$receipt_tmp"
    return 1
  fi
  return 0
}

start_pool() {
  if unit_is_active "$POOL_UNIT"; then
    log "the Vibeshine pool is already active"
    return 0
  fi
  bounded_systemctl 45 "starting $POOL_UNIT" start "$POOL_UNIT"
  unit_is_active "$POOL_UNIT" || fail "$POOL_UNIT did not become active"
  log "the virtual-display pool and its DRM module are ready"
}

stop_pool_and_module() {
  local rc=0 managed token loaded_token refcount
  if unit_is_active "$POOL_UNIT"; then
    bounded_systemctl 45 "stopping $POOL_UNIT" stop "$POOL_UNIT"
  fi
  if unit_is_active "$CONTROL_SOCKET"; then
    bounded_systemctl 20 "stopping $CONTROL_SOCKET" stop "$CONTROL_SOCKET"
  fi
  if unit_is_active "$POOL_UNIT" || unit_is_active "$CONTROL_SOCKET"; then
    fail "the Vibeshine service stack did not stop completely"
  fi
  log "the virtual-display pool and control socket are stopped"

  if [[ ! -d "/sys/module/$MODULE_NAME" ]]; then
    log "the DRM module is not loaded"
    return 0
  fi

  managed="$(state_value "$INSTALL_STATE" managed_load)"
  token="$(state_value "$INSTALL_STATE" load_token)"
  loaded_token="$(cat "/sys/module/$MODULE_NAME/parameters/vibeshine_drmctl_token" 2>/dev/null || true)"
  if [[ "$managed" != 1 || ! "$token" =~ ^[0-9a-f]{64}$ || "$loaded_token" != "$token" ]]; then
    log "the DRM module is not verified as Cask-managed; leaving it loaded"
    return 0
  fi

  log "attempting to unload the verified Cask-managed DRM module"
  timeout --foreground --kill-after=5s 15s "$DRMCTL" unload || rc=$?
  if (( rc == 0 )); then
    log "the Cask-managed DRM module was unloaded"
    return 0
  fi
  refcount="$(cat "/sys/module/$MODULE_NAME/refcnt" 2>/dev/null || true)"
  [[ "$refcount" =~ ^[0-9]+$ ]] || refcount=unknown
  log "the pool is stopped, but the DRM module remains loaded (refcount $refcount); the compositor or another client may still hold it"
  return 2
}

process_starttime() {
  local pid="$1" stat_line rest
  [[ -r "/proc/$pid/stat" ]] || return 1
  IFS= read -r stat_line < "/proc/$pid/stat" || return 1
  rest="${stat_line##*) }"
  local -a fields=()
  read -r -a fields <<< "$rest"
  (("${#fields[@]}" >= 20)) || return 1
  printf '%s\n' "${fields[19]}"
}


process_is_exited() {
  local pid="$1" stat_line rest
  [[ -r "/proc/$pid/stat" ]] || return 0
  IFS= read -r stat_line < "/proc/$pid/stat" || return 0
  rest="${stat_line##*) }"
  local -a fields=()
  read -r -a fields <<< "$rest"
  (("${#fields[@]}" >= 1)) || return 0
  [[ "${fields[0]}" == Z || "${fields[0]}" == X ]]
}

stop_vibepollo_and_wait() {
  local pid="$1" real_uid effective_uid initial_start current_start process_exe app_prefix_real
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || fail "stop-after-pid requires a valid PID"
  if [[ ! -d "/proc/$pid" ]]; then
    log "the Vibepollo process already exited"
    return 0
  fi
  read -r real_uid effective_uid < <(awk '/^Uid:/ { print $2, $3; exit }' "/proc/$pid/status")
  [[ "$real_uid" == "$DESKTOP_UID" && "$effective_uid" == "$DESKTOP_UID" ]] ||
    fail "PID $pid is not owned by the installed desktop account"

  # Never let this privileged action signal an arbitrary desktop process.
  app_prefix_real="$(readlink -f -- "$APP_PREFIX")" || fail "could not resolve the Homebrew app Formula prefix"
  process_exe="$(readlink -f -- "/proc/$pid/exe")" || fail "could not resolve the target executable"
  [[ "$process_exe" == "$app_prefix_real/libexec/vibepollo-bin" ]] ||
    fail "PID $pid is not the installed Homebrew Vibepollo executable"

  initial_start="$(process_starttime "$pid")" || {
    log "the Vibepollo process exited before its identity could be read"
    return 0
  }
  log "requesting graceful SIGTERM for verified Vibepollo PID $pid"
  kill -TERM "$pid" || {
    [[ ! -d "/proc/$pid" ]] || fail "could not signal the verified Vibepollo process"
  }

  for ((attempt = 0; attempt < 600; attempt++)); do
    if [[ ! -r "/proc/$pid/stat" ]] || process_is_exited "$pid"; then
      log "the Vibepollo process exited cleanly"
      return 0
    fi
    current_start="$(process_starttime "$pid" 2>/dev/null || true)"
    if [[ -z "$current_start" || "$current_start" != "$initial_start" ]]; then
      log "the original Vibepollo process has exited"
      return 0
    fi
    sleep 0.1
  done
  fail "timed out waiting for Vibepollo PID $pid to exit; services were left running"
}

enable_autostart() {
  local was_enabled=0 enabled_state entry_installed=0
  enabled_state="$(systemctl is-enabled "$POOL_UNIT" 2>/dev/null || true)"
  [[ "$enabled_state" == enabled ]] && was_enabled=1

  install_autostart_entry
  entry_installed=1
  if ! timeout --foreground --kill-after=5s 30s systemctl enable "$POOL_UNIT"; then
    (( entry_installed == 0 )) || remove_autostart_entry
    fail "could not enable the Vibeshine pool at boot"
  fi
  if ! update_lifecycle_state autostart_enabled 1; then
    (( was_enabled == 1 )) || systemctl disable "$POOL_UNIT" >/dev/null 2>&1 || true
    remove_autostart_entry
    fail "could not persist the autostart state; changes were rolled back"
  fi
  log "autostart enabled; the current session was not changed"
}

disable_autostart() {
  local was_enabled=0
  [[ "$(systemctl is-enabled "$POOL_UNIT" 2>/dev/null || true)" == enabled ]] && was_enabled=1

  if (( was_enabled == 1 )); then
    bounded_systemctl 30 "disabling the Vibeshine pool at boot" disable "$POOL_UNIT"
  fi
  if ! remove_autostart_entry; then
    if (( was_enabled == 1 )); then
      systemctl enable "$POOL_UNIT" >/dev/null 2>&1 || true
    fi
    return 1
  fi
  if ! update_lifecycle_state autostart_enabled 0; then
    install_autostart_entry
    if (( was_enabled == 1 )); then
      systemctl enable "$POOL_UNIT" >/dev/null 2>&1 || true
    fi
    fail "could not persist the disabled autostart state; changes were rolled back"
  fi
  log "autostart disabled; any services already running were left untouched"
}

update_install_state() {
  local key="$1" value="$2" temp
  temp="$(mktemp "$STATE_DIR/.vibeshine-drm-install.XXXXXX")"
  awk -F= -v key="$key" -v value="$value" '
    BEGIN { seen=0 }
    $1 == key { print key "=" value; seen=1; next }
    { print }
    END { if (!seen) print key "=" value }
  ' "$INSTALL_STATE" > "$temp"
  chown root:root "$temp"
  chmod 0644 "$temp"
  mv -f -- "$temp" "$INSTALL_STATE"
}

update_kernel_module() {
  local current_kernel drm_prefix module_file formula_kernel formula_version formula_commit
  local module_version module_vermagic module_params module_srcversion
  local managed token loaded_token key_dir private_key certificate key_fp cert_fp
  local kernel_build sign_file config_file sign_hash configured_hash temp signed_sha cert_sha
  local destination_dir selinux_rule module_context rc=0

  current_kernel="$(uname -r)"
  [[ -n "$current_kernel" ]] || fail "could not determine the running kernel"
  app_prefix_real="$(readlink -f "$APP_PREFIX" 2>/dev/null || true)"
  [[ -n "$app_prefix_real" && "$app_prefix_real" == */Cellar/vibepollo-app/* ]] ||
    fail "could not resolve the installed Homebrew Vibepollo app keg"
  brew_prefix="${app_prefix_real%%/Cellar/*}"
  drm_prefix="$(readlink -f "$brew_prefix/opt/vibepollo-drm" 2>/dev/null || true)"
  [[ -n "$drm_prefix" && "$drm_prefix" == "$brew_prefix"/Cellar/vibepollo-drm/* && -d "$drm_prefix" && ! -L "$drm_prefix" ]] ||
    fail "vibepollo-drm Formula is not installed or its opt link is unsafe"
  formula_kernel="$(cat "$drm_prefix/libexec/kernel-release" 2>/dev/null || true)"
  formula_version="$(cat "$drm_prefix/libexec/module-version" 2>/dev/null || true)"
  formula_commit="$(cat "$drm_prefix/libexec/libvirtualdisplay-commit" 2>/dev/null || true)"
  module_file="$drm_prefix/libexec/vibeshine_drm.ko"
  [[ "$formula_kernel" == "$current_kernel" ]] || fail "Formula was built for an unexpected kernel"
  [[ "$formula_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+\+[0-9a-f]{12}$ ]] || fail "invalid module version metadata"
  [[ "$formula_commit" =~ ^[0-9a-f]{40}$ ]] || fail "invalid source commit metadata"
  [[ -f "$module_file" && ! -L "$module_file" ]] || fail "rebuilt Formula module is missing"

  module_version="$(modinfo -F version "$module_file")"
  module_vermagic="$(modinfo -F vermagic "$module_file" | awk '{print $1}')"
  module_params="$(modinfo -F parm "$module_file")"
  module_srcversion="$(modinfo -F srcversion "$module_file" 2>/dev/null || true)"
  [[ "$module_version" == "$formula_version" && "$module_vermagic" == "$current_kernel" ]] || fail "rebuilt module metadata does not match the running kernel"
  [[ "$module_params" == *"vibeshine_drmctl_token:"* ]] || fail "rebuilt module is missing the controller load-identity parameter"

  if unit_is_active "$POOL_UNIT"; then bounded_systemctl 45 "stopping the virtual-display pool" stop "$POOL_UNIT"; fi
  if unit_is_active "$CONTROL_SOCKET"; then bounded_systemctl 20 "stopping the virtual-display control socket" stop "$CONTROL_SOCKET"; fi
  if unit_is_active "$POOL_UNIT" || unit_is_active "$CONTROL_SOCKET"; then fail "the Vibeshine service stack did not stop completely"; fi

  if [[ -d "/sys/module/$MODULE_NAME" ]]; then
    managed="$(state_value "$INSTALL_STATE" managed_load)"
    token="$(state_value "$INSTALL_STATE" load_token)"
    loaded_token="$(cat "/sys/module/$MODULE_NAME/parameters/vibeshine_drmctl_token" 2>/dev/null || true)"
    [[ "$managed" == 1 && "$token" =~ ^[0-9a-f]{64}$ && "$loaded_token" == "$token" ]] || fail "the loaded DRM module is not verified as Cask-managed; refusing to replace it"
    timeout --foreground --kill-after=5s 15s "$DRMCTL" unload || rc=$?
    (( rc == 0 )) || fail "the DRM module is still in use; close virtual displays and retry"
  fi
  [[ ! -d "/sys/module/$MODULE_NAME" ]] || fail "vibeshine_drm remains loaded; refusing to replace a live module"

  key_dir="$DRM_ROOT/keys"
  private_key="$key_dir/mok.key"
  certificate="$key_dir/MOK.der"
  require_root_directory "$key_dir"
  [[ "$(stat -c '%a' "$key_dir")" == 700 ]] || fail "signing-key directory must be mode 0700"
  require_root_file "$private_key"
  require_root_file "$certificate"
  [[ "$(stat -c '%a' "$private_key")" == 600 || "$(stat -c '%a' "$private_key")" == 400 ]] || fail "private signing key must be mode 0600 or 0400"
  key_fp="$(openssl pkey -passin pass: -in "$private_key" -pubout -outform DER 2>/dev/null | sha256sum | awk '{print $1}')" || fail "could not read unencrypted private signing key"
  cert_fp="$(openssl x509 -inform DER -in "$certificate" -pubkey -noout 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | sha256sum | awk '{print $1}')" || fail "could not read signing certificate"
  [[ "$key_fp" == "$cert_fp" ]] || fail "signing key and certificate do not match"

  kernel_build="$(readlink -f "/lib/modules/$current_kernel/build" 2>/dev/null || true)"
  [[ -n "$kernel_build" && -d "$kernel_build" ]] || fail "matching kernel build directory is unavailable"
  sign_file="$kernel_build/scripts/sign-file"
  [[ -x "$sign_file" ]] || fail "kernel scripts/sign-file is unavailable"
  config_file="$kernel_build/.config"
  [[ -f "$config_file" ]] || config_file="/boot/config-$current_kernel"
  sign_hash=sha256
  if [[ -f "$config_file" ]]; then
    configured_hash="$(sed -n 's/^CONFIG_MODULE_SIG_HASH="\([A-Za-z0-9_-]*\)"$/\1/p' "$config_file" | head -n1)"
    [[ -z "$configured_hash" ]] || sign_hash="$configured_hash"
  fi
  case "$sign_hash" in sha1|sha224|sha256|sha384|sha512) ;; *) fail "unsupported kernel module signing hash";; esac

  temp="$(mktemp -d /var/tmp/vibepollo-drm-update.XXXXXX)"
  cp -- "$module_file" "$temp/vibeshine_drm.ko"
  "$sign_file" "$sign_hash" "$private_key" "$certificate" "$temp/vibeshine_drm.ko"
  [[ -n "$(modinfo -F sig_id "$temp/vibeshine_drm.ko" 2>/dev/null || true)" ]] || fail "kernel module signature metadata is missing"
  signed_sha="$(sha256sum "$temp/vibeshine_drm.ko" | awk '{print $1}')"
  cert_sha="$(sha256sum "$certificate" | awk '{print $1}')"

  destination_dir="$DRM_ROOT/modules/$current_kernel"
  require_root_directory "$DRM_ROOT"
  install -d -o root -g root -m 0755 "$destination_dir"
  [[ ! -L "$destination_dir/vibeshine_drm.ko" && ! -L "$destination_dir/vibeshine_drm.ko.new" ]] || fail "unsafe module destination"
  install -o root -g root -m 0644 "$temp/vibeshine_drm.ko" "$destination_dir/vibeshine_drm.ko.new"
  mv -f -- "$destination_dir/vibeshine_drm.ko.new" "$destination_dir/vibeshine_drm.ko"
  rm -rf -- "$temp"

  if [[ -d /sys/fs/selinux && "$(cat /sys/fs/selinux/enforce 2>/dev/null || echo 0)" == 1 ]]; then
    command -v semanage >/dev/null 2>&1 || fail "semanage is required by SELinux to label the module"
    command -v restorecon >/dev/null 2>&1 || fail "restorecon is required by SELinux to label the module"
    selinux_rule="$DRM_ROOT/modules/[^/]+/vibeshine_drm[.]ko"
    if ! semanage fcontext -l -C | awk -v spec="$selinux_rule" '$1 == spec { found=1 } END { exit !found }'; then
      semanage fcontext -a -f f -t modules_object_t "$selinux_rule" || fail "could not register the SELinux module file-context rule"
      update_install_state selinux_module_fcontext_owned 1
    fi
    restorecon -F "$destination_dir/vibeshine_drm.ko" || fail "could not apply the SELinux module label"
    module_context="$(stat -c '%C' "$destination_dir/vibeshine_drm.ko")"
    [[ "$module_context" == *:modules_object_t:* ]] || fail "SELinux did not apply modules_object_t to the new module"
  fi

  command -v depmod >/dev/null 2>&1 && depmod -a "$current_kernel"
  update_install_state kernel "$current_kernel"
  update_install_state module_version "$formula_version"
  update_install_state module_srcversion "$module_srcversion"
  update_install_state libvirtualdisplay "$formula_commit"
  update_install_state module_sha256 "$signed_sha"
  update_install_state certificate_sha256 "$cert_sha"
  update_install_state managed_load 0
  update_install_state load_token ""
  start_pool
  log "installed the signed DRM module for the running kernel"
}

show_status() {
  printf 'Autostart: %s\n' "$([[ "$AUTOSTART_ENABLED" == 1 ]] && printf enabled || printf disabled)"
  if unit_is_active "$POOL_UNIT"; then
    printf 'Vibeshine pool: active\n'
  else
    printf 'Vibeshine pool: inactive\n'
  fi
  if [[ -d "/sys/module/$MODULE_NAME" ]]; then
    printf 'DRM module: loaded\n'
  else
    printf 'DRM module: unloaded\n'
  fi
}

[[ "$EUID" -eq 0 ]] || fail "this helper must be invoked through pkexec"
load_and_verify_state
verify_invoking_user
resolve_desktop_user

action="${1:-}"
case "$action" in
  start)
    [[ "$#" -eq 1 ]] || fail "start does not accept additional arguments"
    start_pool
    ;;
  stop)
    [[ "$#" -eq 1 ]] || fail "stop does not accept additional arguments"
    stop_pool_and_module
    ;;
  stop-after-pid)
    [[ "$#" -eq 2 ]] || fail "usage: stop-after-pid PID"
    stop_vibepollo_and_wait "$2"
    stop_pool_and_module
    ;;
  enable-autostart)
    [[ "$#" -eq 1 ]] || fail "enable-autostart does not accept additional arguments"
    enable_autostart
    ;;
  disable-autostart|remove-autostart)
    [[ "$#" -eq 1 ]] || fail "$action does not accept additional arguments"
    disable_autostart
    ;;
  status)
    [[ "$#" -eq 1 ]] || fail "status does not accept additional arguments"
    show_status
    ;;
  update-module)
    [[ "$#" -eq 1 ]] || fail "update-module does not accept additional arguments"
    update_kernel_module
    ;;
  *)
    fail "usage: pkexec $SELF {start|stop|stop-after-pid PID|enable-autostart|disable-autostart|remove-autostart|status|update-module}"
    ;;
esac
