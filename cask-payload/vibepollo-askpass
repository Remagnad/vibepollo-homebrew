#!/usr/bin/env bash
set -Eeuo pipefail

# sudo askpass protocol: print the password to stdout, never the prompt.
# Prefer the controlling terminal so interactive removal does not depend on
# X11, Wayland, Qt, GTK, or a desktop-specific authentication agent.
prompt="${1:-[sudo] password: }"
tty_device="/dev/tty"

if [[ -r "$tty_device" && -w "$tty_device" ]]; then
  printf '%s' "$prompt" > "$tty_device"
  password=""
  if ! IFS= read -r -s password < "$tty_device"; then
    printf '\n' > "$tty_device"
    unset password
    exit 1
  fi
  printf '\n' > "$tty_device"
  printf '%s\n' "$password"
  unset password
  exit 0
fi

# Homebrew invokes this helper only because the Cask explicitly selected it.
# Without a controlling terminal there is no safe universal way to display a
# password prompt; fail clearly instead of launching a desktop-specific UI.
printf 'vibepollo askpass: no interactive terminal is available for sudo authentication.\\n' >&2
exit 1
